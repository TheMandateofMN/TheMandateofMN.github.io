# Settings for the forum on one machine. Copy this to .env, which git ignores,
# and take the # off the lines that are wanted. `npm start` and `npm run
# add-user` read it; anything already set in the environment wins over it.
#
# On Fly.io this file is not used: the same settings are in fly.toml, and
# the secret ones are given with `fly secrets set`.
#
# On your own machine none of it is needed: without a .env the forum listens
# on http://127.0.0.1:8787 and keeps its database in server/data.

# --- on the server, set these two -----------------------------------------

# Where members reach the forum. An https address marks the session cookie
# Secure and fixes the one address that forms may be posted from. Leave it
# out on your own machine, or signing in over plain http will not hold.
#PUBLIC_URL=https://forum.gesserit.org

# The forum sits behind Caddy or nginx, which passes on the visitor's address;
# without this the limit on wrong passwords would count the proxy as everyone.
# (Behind a proxy that gives the address in a header of its own, name the
# header instead of 1: on Fly.io it is Fly-Client-IP.)
#TRUST_PROXY=1

# --- seldom wanted --------------------------------------------------------

# Where to listen. Keep it on 127.0.0.1 behind a proxy.
#PORT=8787
#HOST=127.0.0.1

# Where the database and uploaded pictures are kept.
#DATA_DIR=/srv/gesserit/site/server/data

# Where "gesserit.org" at the foot of each page leads.
#LANDING_URL=https://gesserit.org/

# Diagrams are drawn by LaTeX if `latex` and `dvisvgm` are installed. Name the
# programs here if they are not on the PATH, or set either to off.
#LATEX=off
#DVISVGM=off

# Notifications need nothing set. A notification service may want to know who
# to write to about what the forum sends through it: a mailto: or https:
# address. Without this it is given LANDING_URL.
#PUSH_CONTACT=mailto:someone@gesserit.org

# Notifications are sent only through Apple's, Google's, Mozilla's and
# Microsoft's services. Name any other here, as host names with commas between.
#PUSH_HOSTS=push.example.org

# How long to wait before notifying of a message, in thousandths of a second,
# so that whoever is reading the conversation is not told of it.
#PUSH_DELAY_MS=5000

# --- texts to those who are invited (the Invitations page) -----------------

# Inviting someone by a link an admin passes on needs none of this.

# The secret that telephone numbers are sealed with in the database: any 32
# characters or more (`openssl rand -base64 48` makes one). Without it no
# number can be kept. Keep a copy somewhere that is not this machine: if it is
# lost or changed, the numbers kept so far cannot be read again.
#NUMBERS_KEY=

# The Twilio account that texts are sent through, and what they are sent
# from: a number of that account's, or one of its messaging services (MG...).
#TWILIO_ACCOUNT_SID=AC...
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM=+14155550100

# How long to leave between one text and the next when many are sent, in
# thousandths of a second.
#TEXT_GAP_MS=1100

# --- the Send page ---------------------------------------------------------

# Signal is reached through the signal-cli program, which has to be installed
# (https://github.com/AsamK/signal-cli). Name it here if it is not on the PATH.
#SIGNAL_CLI=/usr/local/bin/signal-cli

# --- seldom wanted, continued ----------------------------------------------

# A member who asks for pages faster than anyone reads is refused for a
# while. Set this to off to stop that.
#PACE=off

# Some parts of the forum are put away: the conversations between members,
# the projects, the notifications sent to members' devices, the pages a
# piece's earlier versions are read and put back from, and the admins' list
# of those to be invited. Nothing of them was removed, and what was said,
# written and kept in them is kept. Set any of these to on to bring that
# part back.
#MESSAGES=on
#PROJECTS=on
#NOTIFICATIONS=on
#VERSIONS=on
#INVITATIONS=on
